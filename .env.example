# Copy to .env and edit, then: docker compose up -d --build

# Anyone who can reach the port can download to and browse the music folder,
# so set a password if the VM is reachable from outside your home network.
MUSICA_PASSWORD=change-me

# Adds a "Try the demo" button to the login page. Demo visitors can search and
# download a few songs at a time, but can't change settings or update yt-dlp.
MUSICA_DEMO=0
MUSICA_DEMO_LIMIT=5

# Port the UI is served on.
PORT=8080

# Where songs are saved on the VM, and where settings (and cookies.txt) live.
MUSIC_DIR=./music
DATA_DIR=./data
